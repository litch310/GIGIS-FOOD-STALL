DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gigis_food_house
DB_USER=root
DB_PASSWORD=

# Leave 0 for local HTTP. Set 1 when HTTPS terminates at a proxy that is not
# visible to PHP, or use HTTPS directly (which enables Secure automatically).
APP_COOKIE_SECURE=0

# SMTP over STARTTLS (port 587). Keep the app password only in your ignored
# local .env file or your deployment's secret manager.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost

# ---- Render / Node.js server only (server.js, npm run create-owner) ----
# Render Postgres connection string. On Render the Blueprint fills this in
# with the Internal Database URL. To run create-owner from your PC, use the
# External Database URL from the database's page in the Render dashboard.
DATABASE_URL=
# "disable" for Render's internal URL or a local Postgres without TLS;
# leave empty for the External Database URL (TLS)
DATABASE_SSL=
APP_TIMEZONE=Asia/Manila
